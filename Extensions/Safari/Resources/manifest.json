{
  "manifest_version": 2,
  "name": "Enough",
  "description": "Stub. Version 1 runs the shared on-device filter in Safari.",
  "version": "0.1",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "permissions": ["*://*.instagram.com/*"],
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["*://*.instagram.com/*"],
      "run_at": "document_start"
    }
  ]
}
